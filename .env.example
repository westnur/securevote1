# SecureVote — environment template (EDUCATIONAL PROTOTYPE, LOCAL USE ONLY)
# Copy to `.env` (which is gitignored) and adjust. Every value below is a PLACEHOLDER.
# Never put real secrets, real private keys or real personal data in this project.

NODE_ENV=development

# --- PostgreSQL (used by docker-compose.yml and the backend) ---------------------
POSTGRES_USER=securevote
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=securevote
POSTGRES_PORT=5432
DATABASE_URL=postgresql://securevote:change-me-local-db-password@localhost:5432/securevote?schema=public
# Separate database for backend tests (tests wipe it!). Must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql://securevote:change-me-local-db-password@localhost:5432/securevote_test?schema=public

# --- Backend API -----------------------------------------------------------------
PORT=4000
# Comma-separated list of browser origins allowed to call the API (CORS + CSRF origin check)
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
# Set to true when served over HTTPS
COOKIE_SECURE=false
SESSION_TTL_HOURS=8
# Exposes GET /api/auth/demo-accounts (lists synthetic demo e-mails, never passwords)
DEMO_MODE=true
# Password given to ALL synthetic demo accounts by the seed script (min. 8 characters)
SEED_DEMO_PASSWORD=change-me-demo-password

# --- Local blockchain (Hardhat) ---------------------------------------------------
# Only the local Hardhat chain (31337) is accepted by the backend and frontend.
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# RPC URL the BROWSER uses (defaults to RPC_URL)
PUBLIC_RPC_URL=http://127.0.0.1:8545
# Optional: override the address written by `npm run chain:deploy`
# (packages/contracts/deployments/localhost.json). Leave empty normally.
CONTRACT_ADDRESS=

# --- Frontend (only VITE_* variables are embedded into the browser bundle) --------
# Same-origin "/api" via the Vite proxy when empty
VITE_API_BASE_URL=
# Allows signing with the local node's unlocked test accounts (demo convenience).
# Must be false for anything other than a local demo.
VITE_ENABLE_DEV_SIGNER=true
