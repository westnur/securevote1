{
  "name": "@securevote/contracts",
  "version": "0.1.0",
  "private": true,
  "main": "abi/index.cjs",
  "types": "abi/index.d.ts",
  "exports": {
    ".": {
      "types": "./abi/index.d.ts",
      "import": "./abi/index.mjs",
      "require": "./abi/index.cjs"
    },
    "./abi/SecureVote.json": "./abi/SecureVote.json"
  },
  "scripts": {
    "compile": "hardhat compile && node scripts/export-abi.cjs",
    "test": "hardhat test",
    "node": "hardhat node --hostname 127.0.0.1 --port 8545",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && solhint 'contracts/**/*.sol'"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^22.20.5",
    "hardhat": "^2.29.1",
    "solc": "^0.8.28",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
